# Copy to .env (Windows: copy .env.example .env). Never commit .env.
DATA_PROVIDER=yfinance
# Only needed for licensed providers (Twelve Data, FMP, Polygon, Alpha Vantage...)
DATA_PROVIDER_API_KEY=

CACHE_PATH=data_cache/market_cache.sqlite3
CACHE_TTL_PRICES_HOURS=24
CACHE_TTL_FUNDAMENTALS_HOURS=24
CACHE_TTL_MISSING_MINUTES=60

HISTORY_YEARS=10
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=5
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=1.0

MIN_HISTORY_DAYS=60
RECOMMENDED_HISTORY_DAYS=504
STALE_BAR_DAYS=10

# Risk metrics
RISK_FREE_RATE=0.04
# fixed = always use RISK_FREE_RATE. live = use the US 13-week T-bill yield (cached 12h, rounded
# to 0.25%), falling back to RISK_FREE_RATE if it cannot be fetched. Dashboard only.
RISK_FREE_SOURCE=fixed
RISK_LOOKBACK_YEARS=3
DEFAULT_BENCHMARK=^GSPC

# Monte Carlo (paths must be 10000-50000; drift: shrunk | historical | neutral)
MC_PATHS=10000
# Dashboard only: the most simulations a visitor may request (10000-50000). Each 50000-path
# run needs about 100 MB, so lower this (e.g. 20000) on hosts with 512 MB of RAM.
APP_MAX_PATHS=50000
MC_LOOKBACK_YEARS=3
MC_DRIFT_MODE=shrunk

LOG_LEVEL=INFO
# true = JSON lines (production), false = readable text (local development)
LOG_JSON=false
